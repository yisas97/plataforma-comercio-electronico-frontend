<div class="overflow-x-auto">
  <table class="min-w-full divide-y divide-gray-200">
    <thead class="bg-gray-50">
    <tr>
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >ID</th
      >
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >Nombre</th
      >
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >Precio</th
      >
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >Cantidad</th
      >
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >Categorías</th
      >
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >Etiquetas</th
      >
      <th
          class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"
      >Acciones</th
      >
    </tr>
    </thead>
    <tbody id="product-table-body" class="bg-white divide-y divide-gray-200">
    <!-- Aquí se cargarán dinámicamente los productos -->
    <tr>
      <td
          class="px-6 py-4 whitespace-nowrap text-center text-gray-500"
          colspan="7">Cargando productos...</td
      >
    </tr>
    </tbody>
  </table>
</div>

<script>
  import {fetchCategories} from "../../services/category.service";
  import { productStore } from "../../stores/productStore";
  import type { Product } from "../../types/Product";

  // Interface para el estado del store
  interface ProductState {
    products: Product[];
    loading: boolean;
    error: string | null;
  }

  // Función para renderizar categorías como badges
  async function renderCategoriesBadges(product: Product, categories: any) {
    console.log(product);
    console.log(categories)
    const categorias = await fetchCategories();
    if (product.categoryIds && product.categoryIds.length > 0) {
      return product.categoryIds
          .map(categoryId => {
            console.log("PAssing categoryId: " + categoryId);
            const category = categorias.find(c => c.id === categoryId);
            console.log("Category: " + JSON.stringify(category));
            return category
                ? `<span class="px-2 py-1 bg-blue-100 text-blue-700 rounded-full text-xs mr-1 mb-1 inline-block">
              ${category.name}
            </span>`
                : '';
          })
          .join('');
    }

    // If no categories, show a dash
    return '-';
  }

  // Función para renderizar etiquetas como badges
  function renderTagsBadges(product: Product): string {

    // Alternativa: si tiene tagIds, pero no se muestra cómo buscarlos
    if (product.tagIds && product.tagIds.length > 0) {
      return product.tagIds
          .map(tagId => `
        <span class="px-2 py-1 bg-green-100 text-green-700 rounded-full text-xs mr-1 mb-1 inline-block">
          Tag ${tagId}
        </span>
      `)
          .join('');
    }

    // Si no hay etiquetas, muestra un guión
    return '-';
  }

  // Actualizar la tabla cuando cambie el store
  productStore.subscribe(async ({ products, categories, loading, error }: ProductState) => {
    const tableBody = document.getElementById("product-table-body");
    if (!tableBody) return;

    if (loading) {
      tableBody.innerHTML = `<tr><td colspan="7" class="text-center">Cargando productos...</td></tr>`;
      return;
    }

    if (error) {
      tableBody.innerHTML = `<tr><td colspan="7" class="text-red-500 text-center">Error: ${error}</td></tr>`;
      return;
    }

    if (products.length === 0) {
      tableBody.innerHTML = `<tr><td colspan="7" class="text-center">No hay productos</td></tr>`;
      return;
    }

    // Esperar renderizado de filas con badges de categorías
    const rows = await Promise.all(products.map(async (product: Product) => {
      const categoryBadges = await renderCategoriesBadges(product, categories);
      const tagBadges = renderTagsBadges(product);
      return `
      <tr class="product-row">
        <td class="px-6 py-4 whitespace-nowrap">${product.id}</td>
        <td class="px-6 py-4 whitespace-nowrap">${product.name}</td>
        <td class="px-6 py-4 whitespace-nowrap">$${product.price.toFixed(2)}</td>
        <td class="px-6 py-4 whitespace-nowrap">${product.quantity || 0}</td>
        <td class="px-6 py-4">${categoryBadges}</td>
        <td class="px-6 py-4">${tagBadges}</td>
        <td class="px-6 py-4 whitespace-nowrap">
          <button class="edit-btn bg-blue-500 text-white px-2 py-1 rounded mr-2" data-id="${product.id}">Editar</button>
          <button class="delete-btn bg-red-500 text-white px-2 py-1 rounded" data-id="${product.id}">Eliminar</button>
        </td>
      </tr>`;
    }));

    tableBody.innerHTML = rows.join("");
  });
</script>