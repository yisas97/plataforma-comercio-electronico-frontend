---
import AuthLayout from '@/layouts/AuthLayout.astro';
import { loginUser } from '@/actions/login.actions';
---

<AuthLayout>
  <div class="flex justify-center self-center z-10">
    <div class="p-12 bg-white mx-auto rounded-2xl w-100">
      <div class="mb-4">
        <h3 class="font-semibold text-2xl text-gray-800">Login</h3>
        <p class="text-gray-500">Por favor, ingresa tu cuenta.</p>
      </div>
      <form class="space-y-5" id="login-form">
        <div class="space-y-2">
          <label class="text-sm font-medium text-gray-700 tracking-wide"
          >Email</label
          >
          <input
              class="w-full text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
              type="email"
              name="email"
              placeholder="email@gmail.com"
          />
        </div>
        <div class="space-y-2">
          <label class="mb-5 text-sm font-medium text-gray-700 tracking-wide">
            Password
          </label>
          <input
              class="w-full content-center text-base px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-green-400"
              type="password"
              name="password"
              placeholder="Ingresa tu contraseña"
          />
        </div>
        <div>
          <div class="text-sm">
            <a href="/register" class="text-green-400 hover:text-green-500">
              ¿No tienes cuenta?
            </a>
          </div>
        </div>
        <hr/>
        <div>
          <button
              type="submit"
              id="btn-submit"
              class="disabled:bg-gray-300 w-full flex justify-center bg-green-400 hover:bg-green-500 text-gray-100 p-3 rounded-full tracking-wide font-semibold shadow-lg cursor-pointer transition ease-in duration-500"
          >
            Ingresar
          </button>
        </div>
      </form>
    </div>
  </div>
</AuthLayout>

<script>
  import Swal from 'sweetalert2';
  import { login, setSession } from '@/services/auth.service';

  document.addEventListener('DOMContentLoaded', () => {
    // Redireccionar si ya está autenticado
    if (localStorage.getItem('token')) {
      redirectBasedOnRole();
    }
  });

  const form = document.querySelector('#login-form') as HTMLFormElement;
  const btnSubmit = document.querySelector('#btn-submit') as HTMLButtonElement;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnSubmit.setAttribute('disabled', 'disabled');
    btnSubmit.textContent = 'Iniciando sesión...';

    const formData = new FormData(form);
    const email = formData.get('email') as string;
    const password = formData.get('password') as string;

    try {
      const response = await login({ email, password });

      // Guardar token y datos de usuario
      setSession(response);

      // Redireccionar según el rol
      redirectBasedOnRole();
    } catch (error) {
      console.error(error);
      Swal.fire({
        icon: 'error',
        title: 'Error al ingresar',
        text: error.message || 'Usuario/Contraseña incorrectos',
      });
      btnSubmit.removeAttribute('disabled');
      btnSubmit.textContent = 'Ingresar';
    }
  });

  function redirectBasedOnRole() {
    const userStr = localStorage.getItem('user');
    if (!userStr) return;

    const user = JSON.parse(userStr);

    if (user.role === 'ROLE_ADMIN') {
      window.location.href = '/admin/dashboard';
    } else if (user.role === 'ROLE_PRODUCER') {
      window.location.href = '/productor-local/dashboard';
    } else {
      window.location.href = '/';
    }
  }
</script>