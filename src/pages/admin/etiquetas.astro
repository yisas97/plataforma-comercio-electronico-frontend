---
import MainLayout from "../../layouts/MainLayout.astro";
import AuthGuard from "../../components/auth/AuthGuard.astro";
---

<AuthGuard requireAdmin={true} />
<MainLayout title="Administración de Etiquetas">
    <div class="admin-container">
        <h1 class="text-3xl font-bold mb-8">Administración de Etiquetas</h1>

        <div class="bg-white p-6 rounded-lg shadow-md mb-8">
            <h2 class="text-xl font-semibold mb-4">Añadir Nueva Etiqueta</h2>
            <form id="tag-form" class="space-y-4">
                <input type="hidden" id="tag-id" />
                <div>
                    <label for="tag-name" class="block text-sm font-medium text-gray-700">Nombre *</label>
                    <input
                            type="text"
                            id="tag-name"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm p-2 border"
                            required
                    />
                </div>
                <div class="flex justify-end">
                    <button
                            type="button"
                            id="cancel-btn"
                            class="bg-gray-200 text-gray-800 px-4 py-2 rounded-md mr-2 hidden"
                    >
                        Cancelar
                    </button>
                    <button
                            type="submit"
                            id="submit-btn"
                            class="bg-blue-600 text-white px-4 py-2 rounded-md"
                    >
                        Guardar Etiqueta
                    </button>
                </div>
            </form>
        </div>

        <div class="bg-white p-6 rounded-lg shadow-md">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-semibold">Lista de Etiquetas</h2>
                <div class="search-container">
                    <input
                            type="text"
                            id="search-input"
                            placeholder="Buscar etiqueta..."
                            class="px-4 py-2 border rounded-lg"
                    />
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">ID</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Nombre</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Fecha Creación</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                    </thead>
                    <tbody id="tags-table-body" class="bg-white divide-y divide-gray-200">
                    <!-- Aquí se cargarán las etiquetas dinámicamente -->
                    </tbody>
                </table>
            </div>

            <div id="no-tags-message" class="hidden text-center py-4 text-gray-500">
                No hay etiquetas disponibles.
            </div>
        </div>
    </div>
</MainLayout>

<script>
    import Swal from "sweetalert2";
    import { fetchTags, searchTags, createTag, updateTag, deleteTag } from "../../services/tag.service";
    import { tagStore } from "../../stores/tag.store";

    // Elementos del DOM
    const tagForm = document.getElementById("tag-form");
    const tagIdInput = document.getElementById("tag-id");
    const tagNameInput = document.getElementById("tag-name");
    const submitButton = document.getElementById("submit-btn");
    const cancelButton = document.getElementById("cancel-btn");
    const searchInput = document.getElementById("search-input");
    const tagsTableBody = document.getElementById("tags-table-body");
    const noTagsMessage = document.getElementById("no-tags-message");

    // Estado de edición
    let isEditing = false;

    // Cargar etiquetas al iniciar la página
    document.addEventListener("DOMContentLoaded", async () => {
        try {
            const tags = await fetchTags();
            tagStore.set({ tags });
            renderTags(tags);
        } catch (error) {
            console.error("Error loading tags:", error);
            Swal.fire({
                icon: "error",
                title: "¡Error!",
                text: "No se pudieron cargar las etiquetas",
            });
        }

        // Setup del buscador
        if (searchInput) {
            searchInput.addEventListener("input", async (e) => {
                const searchTerm = e.target.value.trim();

                try {
                    let tags;
                    if (searchTerm) {
                        tags = await searchTags(searchTerm);
                    } else {
                        tags = await fetchTags();
                    }
                    renderTags(tags);
                } catch (error) {
                    console.error("Error searching tags:", error);
                }
            });
        }
    });

    // Manejar envío del formulario
    tagForm.addEventListener("submit", async (e) => {
        e.preventDefault();

        const tagData = {
            name: tagNameInput.value
        };

        try {
            if (isEditing) {
                // Actualizar etiqueta existente
                await updateTag(tagIdInput.value, tagData);
                Swal.fire({
                    icon: "success",
                    title: "¡Actualizado!",
                    text: "La etiqueta ha sido actualizada correctamente",
                });
            } else {
                // Crear nueva etiqueta
                await createTag(tagData);
                Swal.fire({
                    icon: "success",
                    title: "¡Creado!",
                    text: "La etiqueta ha sido creada correctamente",
                });
            }

            // Resetear formulario y recargar etiquetas
            resetForm();
            const tags = await fetchTags();
            tagStore.set({ tags });
            renderTags(tags);
        } catch (error) {
            console.error("Error saving tag:", error);
            Swal.fire({
                icon: "error",
                title: "¡Error!",
                text: isEditing
                    ? "No se pudo actualizar la etiqueta"
                    : "No se pudo crear la etiqueta",
            });
        }
    });

    // Botón Cancelar (volver al modo creación)
    cancelButton.addEventListener("click", () => {
        resetForm();
    });

    // Renderizar etiquetas en la tabla
    function renderTags(tags) {
        if (!tagsTableBody) return;

        tagsTableBody.innerHTML = "";

        if (!tags || tags.length === 0) {
            noTagsMessage.classList.remove("hidden");
            return;
        }

        noTagsMessage.classList.add("hidden");

        tags.forEach(tag => {
            const row = document.createElement("tr");
            row.className = "tag-row";

            // Formatear fecha
            const createdDate = new Date(tag.createdAt);
            const formattedDate = createdDate.toLocaleDateString();

            row.innerHTML = `
        <td class="px-6 py-4 whitespace-nowrap">${tag.id}</td>
        <td class="px-6 py-4 whitespace-nowrap">${tag.name}</td>
        <td class="px-6 py-4 whitespace-nowrap">${formattedDate}</td>
        <td class="px-6 py-4 whitespace-nowrap">
          <button class="edit-btn text-blue-600 hover:text-blue-800 mr-3" data-id="${tag.id}">
            Editar
          </button>
          <button class="delete-btn text-red-600 hover:text-red-800" data-id="${tag.id}">
            Eliminar
          </button>
        </td>
      `;

            tagsTableBody.appendChild(row);
        });

        // Agregar event listeners a los botones
        setupActionButtons();
    }

    // Configurar botones de acción (editar/eliminar)
    function setupActionButtons() {
        // Botones de editar
        document.querySelectorAll(".edit-btn").forEach(button => {
            button.addEventListener("click", handleEditTag);
        });

        // Botones de eliminar
        document.querySelectorAll(".delete-btn").forEach(button => {
            button.addEventListener("click", handleDeleteTag);
        });
    }

    // Manejar click en botón editar
    function handleEditTag(e) {
        const tagId = e.target.dataset.id;
        const tags = tagStore.get().tags;
        const tagToEdit = tags.find(t => t.id == tagId);

        if (tagToEdit) {
            // Llenar formulario con datos de la etiqueta
            tagIdInput.value = tagToEdit.id;
            tagNameInput.value = tagToEdit.name;

            // Cambiar estado y textos
            isEditing = true;
            submitButton.textContent = "Actualizar Etiqueta";
            cancelButton.classList.remove("hidden");

            // Scroll al formulario
            document.querySelector(".admin-container").scrollIntoView({ behavior: "smooth" });
        }
    }

    // Manejar click en botón eliminar
    async function handleDeleteTag(e) {
        const tagId = e.target.dataset.id;

        Swal.fire({
            title: "¿Estás seguro?",
            text: "Esta acción no se puede revertir. Los productos relacionados perderán esta etiqueta.",
            icon: "warning",
            showCancelButton: true,
            confirmButtonColor: "#3085d6",
            cancelButtonColor: "#d33",
            confirmButtonText: "Sí, eliminar",
            cancelButtonText: "Cancelar",
        }).then(async (result) => {
            if (result.isConfirmed) {
                try {
                    await deleteTag(tagId);

                    // Actualizar la lista de etiquetas
                    const tags = await fetchTags();
                    tagStore.set({ tags });
                    renderTags(tags);

                    Swal.fire(
                        "¡Eliminada!",
                        "La etiqueta ha sido eliminada.",
                        "success"
                    );
                } catch (error) {
                    console.error("Error deleting tag:", error);
                    Swal.fire({
                        icon: "error",
                        title: "¡Error!",
                        text: "No se pudo eliminar la etiqueta",
                    });
                }
            }
        });
    }

    // Resetear formulario a estado inicial
    function resetForm() {
        tagForm.reset();
        tagIdInput.value = "";
        isEditing = false;
        submitButton.textContent = "Guardar Etiqueta";
        cancelButton.classList.add("hidden");
    }
</script>